<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.google.drive.integration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="google_drive">
                    <div class="o_setting_left_pane">
                        <field name="gdrive_button" string="Google Drive"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="gdrive_button" string="Google Drive"/>
                        <div class="text-muted">
                            Create folders in Google Drive and store the shareable link on records
                        </div>
                        <div class="content-group mt16" invisible="not gdrive_button">
                            <div class="row mt8">
                                <label for="gdrive_client_id" class="col-lg-4 o_light_label"/>
                                <field name="gdrive_client_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="gdrive_client_secret" class="col-lg-4 o_light_label"/>
                                <field name="gdrive_client_secret" password="True"/>
                            </div>
                            <div class="row mt8">
                                <label for="gdrive_parent_folder_id" class="col-lg-4 o_light_label"/>
                                <field name="gdrive_parent_folder_id"/>
                            </div>
                            <div class="row mt8">
                                <label for="gdrive_refresh_token" class="col-lg-4 o_light_label"/>
                                <field name="gdrive_refresh_token" readonly="1"/>
                            </div>
                            <div class="row mt8">
                                <label for="gdrive_auto_upload" class="col-lg-4 o_light_label"/>
                                <field name="gdrive_auto_upload"/>
                            </div>
                            <div class="mt16">
                                <button string="Connect to Google Drive"
                                        type="object"
                                        name="action_connect_google_drive"
                                        class="btn btn-primary"
                                        icon="fa-google"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
