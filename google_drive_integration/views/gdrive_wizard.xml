<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_google_drive_folder_wizard_form" model="ir.ui.view">
        <field name="name">google.drive.folder.wizard.form</field>
        <field name="model">google.drive.folder.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Google Drive Folder">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="partner_id" invisible="1"/>
                    <field name="name" placeholder="Enter folder name"/>
                </group>
                <footer>
                    <button name="create_gdrive_folder"
                            string="Create Folder"
                            type="object"
                            class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"
                            data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
