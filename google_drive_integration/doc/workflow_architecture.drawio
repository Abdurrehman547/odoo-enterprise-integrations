<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="gdrive_workflow" name="Google Drive Integration Workflow">
    <mxGraphModel dx="1600" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="980" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- LANE 1: ADMIN & SETTINGS -->
        <mxCell id="lane_admin" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="1. Administrator &amp; Settings (res.config.settings)" vertex="1">
          <mxGeometry height="900" width="340" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="g_step_config" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=11;" value="1. Configure Credentials&#xa;(Client ID, Secret, Root Folder ID)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="g_step_auto_toggle" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=11;" value="2. Configure Auto-Upload Setting&#xa;(gdrive_auto_upload toggle)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="g_step_connect_btn" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontSize=11;" value="3. Click 'Connect to Google Drive'&#xa;(Generates CSRF state &amp; auth URL)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="g_step_auth_success" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=11;" value="7. Receive Callback &amp; Tokens&#xa;Tokens saved to ir.config_parameter" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="440" as="geometry" />
        </mxCell>
        <mxCell id="g_step_active_badge" parent="lane_admin" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.15;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" value="Google Drive Integration Active" vertex="1">
          <mxGeometry height="50" width="260" x="40" y="525" as="geometry" />
        </mxCell>

        <!-- LANE 2: GOOGLE CLOUD PLATFORM -->
        <mxCell id="lane_google" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="2. Google Cloud Platform (OAuth 2.0 &amp; Drive API v3)" vertex="1">
          <mxGeometry height="900" width="370" x="410" y="40" as="geometry" />
        </mxCell>
        <mxCell id="g_step_consent" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=11;" value="4. Google OAuth 2.0 Consent Screen&#xa;(Scope: drive.file, access_type=offline)" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="220" as="geometry" />
        </mxCell>
        <mxCell id="g_step_user_grant" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=11;" value="5. User Grants Permission&#xa;Google redirects with Auth Code &amp; State" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="300" as="geometry" />
        </mxCell>
        <mxCell id="g_step_token_exchange" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontStyle=1;fontSize=11;" value="6. Token Exchange (POST /token)&#xa;Validate CSRF, exchange code for refresh token" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="380" as="geometry" />
        </mxCell>
        <mxCell id="g_step_create_folder_api" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=11;" value="10. Drive API: files().create()&#xa;Creates customer folder in parent_folder_id" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="610" as="geometry" />
        </mxCell>
        <mxCell id="g_step_perm_api" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;" value="11. Permissions API: permissions().create()&#xa;Sets role: reader, type: anyone (shareable link)" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="695" as="geometry" />
        </mxCell>
        <mxCell id="g_step_upload_file_api" parent="lane_google" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=11;" value="16. Drive API: Upload File (files().create)&#xa;Uploads attachment binary to customer folder" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="805" as="geometry" />
        </mxCell>

        <!-- LANE 3: USER OPERATIONS & CONTACT / CRM RECORDS -->
        <mxCell id="lane_records" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="3. Record Operations (res.partner &amp; crm.lead)" vertex="1">
          <mxGeometry height="900" width="350" x="810" y="40" as="geometry" />
        </mxCell>
        <mxCell id="g_step_folder_btn" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=11;" value="8. Click 'Create Google Drive Folder'&#xa;(Contact header &amp; CRM Opportunity header)" vertex="1">
          <mxGeometry height="55" width="260" x="45" y="440" as="geometry" />
        </mxCell>
        <mxCell id="g_step_wiz_name" parent="lane_records" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d1c4e9;strokeColor=#512da8;fontSize=11;" value="9. Confirm Folder Name in Wizard&#xa;(google.drive.folder.wizard)" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="525" as="geometry" />
        </mxCell>
        <mxCell id="g_step_save_link" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontStyle=1;fontSize=11;" value="12. Store webViewLink on Partner &amp; CRM&#xa;(gdrive_folder_id &amp; gdrive_folder_link)" vertex="1">
          <mxGeometry height="55" width="260" x="45" y="695" as="geometry" />
        </mxCell>
        <mxCell id="g_step_smart_btn" parent="lane_records" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00897b;fontStyle=1;fontSize=11;" value="13. Magic Stat Button &amp; Kanban URL Active&#xa;(1-Click direct navigation to Drive)" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="775" as="geometry" />
        </mxCell>
        <mxCell id="g_step_chatter_log" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;fontStyle=1;" value="18. Post Chatter Notification on Record&#xa;File has been uploaded to Google Drive: [file]" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="840" as="geometry" />
        </mxCell>

        <!-- LANE 4: ATTACHMENT SYNC ENGINE -->
        <mxCell id="lane_attachments" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="4. Attachment Sync Engine (ir.attachment)" vertex="1">
          <mxGeometry height="900" width="340" x="1190" y="40" as="geometry" />
        </mxCell>
        <mxCell id="g_step_trigger_auto" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;fontStyle=1;fontSize=11;" value="14a. Auto-Upload on Contact or CRM&#xa;File attached to Contact or CRM Lead chatter" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="525" as="geometry" />
        </mxCell>
        <mxCell id="g_step_trigger_manual" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;fontStyle=1;fontSize=11;" value="14b. Header / Manual Action Trigger&#xa;'Upload to Google Drive' on Form / Attachments" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="g_step_resolve_folder" parent="lane_attachments" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontStyle=1;fontSize=11;" value="15. Resolve Customer Folder ID&#xa;(partner._get_gdrive_folder_id)" vertex="1">
          <mxGeometry height="70" width="260" x="40" y="695" as="geometry" />
        </mxCell>
        <mxCell id="g_step_save_att_fields" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=11;" value="17. Store File ID &amp; File Link on Attachment&#xa;(gdrive_file_id &amp; gdrive_file_link)" vertex="1">
          <mxGeometry height="50" width="260" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="g_step_toast" parent="lane_attachments" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=11;" value="19. User Notification Toast (Success)&#xa;X attachment(s) uploaded successfully" vertex="1">
          <mxGeometry height="45" width="260" x="40" y="845" as="geometry" />
        </mxCell>

        <!-- EDGES & FLOW -->
        <mxCell id="ge1" edge="1" parent="1" source="g_step_config" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_auto_toggle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge2" edge="1" parent="1" source="g_step_auto_toggle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_connect_btn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge3" edge="1" parent="1" source="g_step_connect_btn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_consent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge4" edge="1" parent="1" source="g_step_consent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_user_grant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge5" edge="1" parent="1" source="g_step_user_grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_token_exchange">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge6" edge="1" parent="1" source="g_step_token_exchange" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_auth_success">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge7" edge="1" parent="1" source="g_step_auth_success" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_active_badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge8" edge="1" parent="1" source="g_step_active_badge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_folder_btn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge9" edge="1" parent="1" source="g_step_folder_btn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_wiz_name">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge10" edge="1" parent="1" source="g_step_wiz_name" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_create_folder_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge11" edge="1" parent="1" source="g_step_create_folder_api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_perm_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge12" edge="1" parent="1" source="g_step_perm_api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_save_link">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge13" edge="1" parent="1" source="g_step_save_link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_smart_btn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge14" edge="1" parent="1" source="g_step_save_link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;" target="g_step_trigger_auto">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge15" edge="1" parent="1" source="g_step_trigger_auto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_resolve_folder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge16" edge="1" parent="1" source="g_step_trigger_manual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_resolve_folder">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ge17" edge="1" parent="1" source="g_step_resolve_folder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="g_step_upload_file_api">
