        <mxCell id="de3" edge="1" parent="1" source="d_step_open_wiz" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_auth_url">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de4" edge="1" parent="1" source="d_step_auth_url" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_user_grant">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de5" edge="1" parent="1" source="d_step_user_grant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_paste_code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de6" edge="1" parent="1" source="d_step_paste_code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_exchange_code">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de7" edge="1" parent="1" source="d_step_exchange_code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_tokens_stored">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de8" edge="1" parent="1" source="d_step_tokens_stored" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_active_badge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de9" edge="1" parent="1" source="d_step_active_badge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_folder_btn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de10" edge="1" parent="1" source="d_step_folder_btn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_wiz_name">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
