<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="dropbox_workflow" name="Dropbox Integration Workflow">
    <mxGraphModel dx="1600" dy="980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1530" pageHeight="980" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- LANE 1: ADMIN & SETTINGS -->
        <mxCell id="lane_admin" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="1. Administrator &amp; Settings (res.config.settings)" vertex="1">
          <mxGeometry height="900" width="340" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="d_step_config" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=11;" value="1. Configure Dropbox App&#xa;(App Key, Secret, Base Folder Path)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="50" as="geometry" />
        </mxCell>
        <mxCell id="d_step_auto_toggle" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontStyle=1;fontSize=11;" value="2. Configure Auto-Upload Setting&#xa;(dropbox_auto_upload toggle)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="135" as="geometry" />
        </mxCell>
        <mxCell id="d_step_open_wiz" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1e88e5;fontSize=11;" value="3. Click 'Setup Access Token'&#xa;(Opens authentication.wizard)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="220" as="geometry" />
        </mxCell>
        <mxCell id="d_step_paste_code" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#5e35b1;fontStyle=1;fontSize=11;" value="6. Paste Auth Code in Wizard &amp; Confirm&#xa;(Triggers token exchange)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="380" as="geometry" />
        </mxCell>
        <mxCell id="d_step_tokens_stored" parent="lane_admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=11;" value="8. Tokens Saved in ir.config_parameter&#xa;(access_token &amp; refresh_token persisted)" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="465" as="geometry" />
        </mxCell>
        <mxCell id="d_step_active_badge" parent="lane_admin" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;size=0.15;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=12;" value="Dropbox Integration Active" vertex="1">
          <mxGeometry height="50" width="260" x="40" y="545" as="geometry" />
        </mxCell>

        <!-- LANE 2: DROPBOX API & OAUTH -->
        <mxCell id="lane_dropbox" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="2. Dropbox Cloud Platform (OAuth 2.0 &amp; Files API v2)" vertex="1">
          <mxGeometry height="900" width="370" x="410" y="40" as="geometry" />
        </mxCell>
        <mxCell id="d_step_auth_url" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=11;" value="4. Generate OAuth 2.0 Auth URL&#xa;(DropboxOAuth2FlowNoRedirect, offline)" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="220" as="geometry" />
        </mxCell>
        <mxCell id="d_step_user_grant" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#fb8c00;fontSize=11;" value="5. User Grants Dropbox Permission&#xa;Dropbox displays 1-time Authorization Code" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="300" as="geometry" />
        </mxCell>
        <mxCell id="d_step_exchange_code" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=11;" value="7. Exchange Code for Tokens&#xa;(dbx_auth.finish(auth_code))" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="380" as="geometry" />
        </mxCell>
        <mxCell id="d_step_create_folder_api" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontStyle=1;fontSize=11;" value="11. files_create_folder_v2(path)&#xa;Creates customer folder under Base Path" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="610" as="geometry" />
        </mxCell>
        <mxCell id="d_step_share_link_api" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#fbc02d;fontSize=11;" value="12. sharing_create_shared_link_with_settings&#xa;Generates public shareable web link" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="695" as="geometry" />
        </mxCell>
        <mxCell id="d_step_upload_file_api" parent="lane_dropbox" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontStyle=1;fontSize=11;" value="16. files_upload(bytes, path, mode=add)&#xa;Uploads attachment binary to customer folder" vertex="1">
          <mxGeometry height="55" width="270" x="50" y="805" as="geometry" />
        </mxCell>

        <!-- LANE 3: USER OPERATIONS & CONTACT / CRM RECORDS -->
        <mxCell id="lane_records" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="3. Record Operations (res.partner &amp; crm.lead)" vertex="1">
          <mxGeometry height="900" width="350" x="810" y="40" as="geometry" />
        </mxCell>
        <mxCell id="d_step_folder_btn" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontStyle=1;fontSize=11;" value="9. Click 'Create Dropbox Folder'&#xa;(Contact header &amp; CRM Opportunity header)" vertex="1">
          <mxGeometry height="55" width="260" x="45" y="440" as="geometry" />
        </mxCell>
        <mxCell id="d_step_wiz_name" parent="lane_records" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#d1c4e9;strokeColor=#512da8;fontSize=11;" value="10. Confirm Folder Name in Wizard&#xa;(dropbox.folder.wizard)" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="525" as="geometry" />
        </mxCell>
        <mxCell id="d_step_save_link" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#388e3c;fontStyle=1;fontSize=11;" value="13. Store Path &amp; URL on Partner &amp; CRM&#xa;(dropbox_folder_link &amp; path)" vertex="1">
          <mxGeometry height="55" width="260" x="45" y="695" as="geometry" />
        </mxCell>
        <mxCell id="d_step_smart_btn" parent="lane_records" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b2dfdb;strokeColor=#00897b;fontStyle=1;fontSize=11;" value="14. Magic Stat Button &amp; Kanban Link Active&#xa;(1-Click direct navigation to Dropbox)" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="775" as="geometry" />
        </mxCell>
        <mxCell id="d_step_chatter_log" parent="lane_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede7f6;strokeColor=#7e57c2;fontSize=11;fontStyle=1;" value="19. Post Chatter Notification on Record&#xa;File has been uploaded to Dropbox: [file]" vertex="1">
          <mxGeometry height="50" width="260" x="45" y="840" as="geometry" />
        </mxCell>

        <!-- LANE 4: ATTACHMENT SYNC ENGINE -->
        <mxCell id="lane_attachments" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#f8f9fa;strokeColor=#495057;fontStyle=1;fontSize=13;" value="4. Attachment Sync Engine (ir.attachment)" vertex="1">
          <mxGeometry height="900" width="340" x="1190" y="40" as="geometry" />
        </mxCell>
        <mxCell id="d_step_trigger_auto" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;fontStyle=1;fontSize=11;" value="15a. Auto-Upload on Contact or CRM&#xa;File attached to Contact or CRM Lead chatter" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="525" as="geometry" />
        </mxCell>
        <mxCell id="d_step_trigger_manual" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#ffa000;fontStyle=1;fontSize=11;" value="15b. Header / Manual Action Trigger&#xa;'Upload to Dropbox' on Form / Attachments" vertex="1">
          <mxGeometry height="55" width="260" x="40" y="610" as="geometry" />
        </mxCell>
        <mxCell id="d_step_resolve_folder" parent="lane_attachments" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c2185b;fontStyle=1;fontSize=11;" value="16. Resolve Customer Folder Path&#xa;(partner._get_dropbox_folder_path)" vertex="1">
          <mxGeometry height="70" width="260" x="40" y="695" as="geometry" />
        </mxCell>
        <mxCell id="d_step_save_att_fields" parent="lane_attachments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#43a047;fontStyle=1;fontSize=11;" value="17. Store File ID &amp; File Link on Attachment&#xa;(dropbox_file_id &amp; dropbox_file_link)" vertex="1">
          <mxGeometry height="50" width="260" x="40" y="790" as="geometry" />
        </mxCell>
        <mxCell id="d_step_toast" parent="lane_attachments" style="ellipse;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontStyle=1;fontSize=11;" value="18. User Notification Toast (Success)&#xa;X attachment(s) uploaded successfully" vertex="1">
          <mxGeometry height="45" width="260" x="40" y="845" as="geometry" />
        </mxCell>

        <!-- EDGES & FLOW -->
        <mxCell id="de1" edge="1" parent="1" source="d_step_config" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_auto_toggle">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de2" edge="1" parent="1" source="d_step_auto_toggle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_open_wiz">
          <mxGeometry relative="1" as="geometry" />
