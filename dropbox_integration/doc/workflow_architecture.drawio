          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de14" edge="1" parent="1" source="d_step_save_link" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_smart_btn">
          <mxGeometry relative="1" as="geometry" />
