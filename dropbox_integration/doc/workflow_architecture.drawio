          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="de12" edge="1" parent="1" source="d_step_create_folder_api" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="d_step_share_link_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
