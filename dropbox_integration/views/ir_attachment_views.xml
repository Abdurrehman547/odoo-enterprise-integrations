<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attachment_form_inherit_dropbox" model="ir.ui.view">
        <field name="name">ir.attachment.form.inherit.dropbox</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_upload_to_dropbox"
                            string="Upload to Dropbox"
                            type="object"
                            class="oe_highlight"
                            icon="fa-cloud-upload"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='url']" position="after">
                <field name="dropbox_file_link" widget="url" readonly="1" invisible="not dropbox_file_link"/>
                <field name="dropbox_file_id" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_ir_attachment_upload_dropbox" model="ir.actions.server">
        <field name="name">Upload to Dropbox</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="binding_model_id" ref="base.model_ir_attachment"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
action = records.action_upload_to_dropbox()
        </field>
    </record>
</odoo>
