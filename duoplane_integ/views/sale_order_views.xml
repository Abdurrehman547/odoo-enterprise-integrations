    <!-- Scheduled Action -->
    <record id="ir_cron_import_retailer_sku" model="ir.cron">
        <field name="name">Import Retailer SKU from Excel</field>
        <field name="model_id" ref="model_product_retailer_sku_import"/>
        <field name="state">code</field>
        <field name="code">model.cron_import_retailer_sku()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False"/>
    </record>
</odoo>