<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View - Add Duoplane Fields -->
    <record id="view_order_form_duoplane" model="ir.ui.view">
        <field name="name">sale.order.form.duoplane</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="x_duoplane_synced" invisible="1"/>
                <field name="x_duoplane_po_id" readonly="1" invisible="not x_duoplane_synced"/>
                <field name="x_retailer" readonly="1" invisible="not x_duoplane_synced"/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order Tree View - Add Duoplane Indicator -->
    <record id="view_order_tree_duoplane" model="ir.ui.view">
        <field name="name">sale.order.tree.duoplane</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="x_duoplane_synced" optional="hide"/>
                <field name="x_retailer" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- Duoplane Orders Action -->
    <record id="action_duoplane_orders" model="ir.actions.act_window">
        <field name="name">Duoplane Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('x_duoplane_synced', '=', True)]</field>
        <field name="context">{'search_default_x_duoplane_synced': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Duoplane orders yet
            </p>
            <p>
                Orders synced from Duoplane will appear here.
            </p>
        </field>
    </record>

