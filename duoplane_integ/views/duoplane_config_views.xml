<!--        <field name="name">duoplane.config.tree</field>-->
<!--        <field name="model">duoplane.config</field>-->
<!--        <field name="arch" type="xml">-->
<!--            <tree string="Duoplane Configurations">-->
<!--                <field name="name"/>-->
<!--                <field name="active"/>-->
<!--                <field name="last_sync_date"/>-->
<!--                <field name="last_sync_status"/>-->
<!--                <field name="total_orders_synced"/>-->
<!--            </tree>-->
<!--        </field>-->
<!--    </record>-->

    <!-- Duoplane Config Action -->
    <record id="action_duoplane_config" model="ir.actions.act_window">
        <field name="name">Duoplane Settings</field>
        <field name="res_model">duoplane.config</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Configure Duoplane Integration
            </p>
            <p>
                Set up your Duoplane API credentials to start syncing orders.
            </p>
        </field>
    </record>
</odoo>