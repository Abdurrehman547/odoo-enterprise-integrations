<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_duoplane_sync_wizard_form" model="ir.ui.view">
        <field name="name">duoplane.sync.wizard.form</field>
        <field name="model">duoplane.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Duoplane Orders">
                <group>
                    <field name="config_id"/>
                    <field name="sync_date_from"/>
                    <field name="sync_unfulfilled_only"/>
                </group>
                <footer>
                    <button name="action_sync" string="Sync Now" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_duoplane_sync_wizard" model="ir.actions.act_window">
        <field name="name">Manual Sync</field>
        <field name="res_model">duoplane.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>