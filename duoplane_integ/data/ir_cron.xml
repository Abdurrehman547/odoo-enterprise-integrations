<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action - Sync Duoplane Orders Every 15 Minutes -->
        <record id="ir_cron_duoplane_sync" model="ir.cron">
            <field name="name">Duoplane: Sync Orders</field>
            <field name="model_id" ref="model_duoplane_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_orders()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>