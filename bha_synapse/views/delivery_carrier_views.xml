<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_delivery_carrier_form_synapse" model="ir.ui.view">
        <field name="name">delivery.carrier.form.synapse</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <!-- Place the Synapse mapping fields as proper labelled rows in the
                 provider group. Anchoring on integration_level (a direct child
                 of the group) keeps them out of the delivery_type <div> so they
                 render with their own labels instead of squashed next to the
                 "Install more Providers" button. -->
            <field name="integration_level" position="after">
                <field name="synapse_service_code"/>
                <field name="synapse_carrier_code"/>
            </field>
        </field>
    </record>
</odoo>

