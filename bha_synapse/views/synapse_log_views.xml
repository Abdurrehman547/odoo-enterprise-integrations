<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_synapse_log_list" model="ir.ui.view">
        <field name="name">synapse.log.list</field>
        <field name="model">synapse.log</field>
        <field name="arch" type="xml">
<list string="Sync Logs" create="false" decoration-success="state == 'success'" decoration-danger="state == 'failed'">
                <field name="create_date"/>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="job_type"/>
                <field name="direction"/>
                <field name="res_ref"/>
                <field name="state" widget="badge" decoration-success="state == 'success'" decoration-danger="state == 'failed'"/>
                <field name="message" optional="show"/>
                <field name="queue_job_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_synapse_log_search" model="ir.ui.view">
        <field name="name">synapse.log.search</field>
        <field name="model">synapse.log</field>
        <field name="arch" type="xml">
<search>
                <field name="name"/>
                <field name="res_ref"/>
                <field name="connection_id"/>
                <filter name="success" string="Success" domain="[('state','=','success')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by':'job_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_synapse_log_form" model="ir.ui.view">
        <field name="name">synapse.log.form</field>
        <field name="model">synapse.log</field>
        <field name="arch" type="xml">
<form string="Sync Log" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="connection_id"/>
                            <field name="queue_job_id"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="job_type"/>
                            <field name="direction"/>
                            <field name="model"/>
                            <field name="res_ref"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_synapse_log" model="ir.actions.act_window">
        <field name="name">{'en_US': 'Logs'}</field>
        <field name="res_model">synapse.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_synapse_log_search"/>
    </record>

    <menuitem id="menu_synapse_log" name="Logs" parent="menu_synapse_root" action="action_synapse_log" sequence="50"/>
</odoo>
