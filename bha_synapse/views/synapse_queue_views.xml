<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_synapse_queue_list" model="ir.ui.view">
        <field name="name">synapse.queue.job.list</field>
        <field name="model">synapse.queue.job</field>
        <field name="arch" type="xml">
            <list string="Sync Queue" create="false"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'failed'"
                  decoration-muted="state == 'progress'">
                <header>
                    <button name="action_process" string="Process" type="object"/>
                    <button name="action_requeue" string="Requeue" type="object"/>
                </header>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="job_type"/>
                <field name="direction"/>
                <field name="synapse_ref"/>
                <field name="attempts"/>
                <field name="last_attempt"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-info="state == 'new'"
                       decoration-warning="state == 'progress'"/>
                <field name="message" optional="hide"/>
                <button name="action_process" string="Process" type="object"
                        icon="fa-play" invisible="state == 'done'"/>
                <button name="action_requeue" string="Requeue" type="object"
                        icon="fa-refresh" invisible="state != 'failed'"/>
            </list>
        </field>
    </record>

    <record id="view_synapse_queue_form" model="ir.ui.view">
        <field name="name">synapse.queue.job.form</field>
        <field name="model">synapse.queue.job</field>
        <field name="arch" type="xml">
            <form string="Sync Queue Job" create="false">
                <header>
                    <button name="action_process" string="Process" type="object"
                            class="oe_highlight" invisible="state == 'done'"/>
                    <button name="action_requeue" string="Requeue" type="object"
                            invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,progress,done,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="job_type"/>
                            <field name="direction"/>
                            <field name="synapse_ref"/>
                        </group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="attempts"/>
                            <field name="last_attempt"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_synapse_queue_search" model="ir.ui.view">
        <field name="name">synapse.queue.job.search</field>
        <field name="model">synapse.queue.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="synapse_ref"/>
                <field name="connection_id"/>
                <filter name="new" string="New" domain="[('state','=','new')]"/>
                <filter name="progress" string="In Progress" domain="[('state','=','progress')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="failed" string="Failed" domain="[('state','=','failed')]"/>
                <separator/>
                <filter name="import" string="Import" domain="[('direction','=','import')]"/>
                <filter name="export" string="Export" domain="[('direction','=','export')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="State" context="{'group_by':'state'}"/>
                    <filter name="group_type" string="Type" context="{'group_by':'job_type'}"/>
                    <filter name="group_conn" string="Connection" context="{'group_by':'connection_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_synapse_queue" model="ir.actions.act_window">
        <field name="name">Sync Queue</field>
        <field name="res_model">synapse.queue.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_synapse_queue_search"/>
    </record>

    <menuitem id="menu_synapse_queue" name="Sync Queue"
              parent="menu_synapse_root" action="action_synapse_queue" sequence="40"/>
</odoo>

