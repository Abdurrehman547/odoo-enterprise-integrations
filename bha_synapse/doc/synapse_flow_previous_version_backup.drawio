        <mxCell id="n17" parent="1" value="&lt;b&gt;All Items Fulfilled?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1">
