        <mxCell id="n18" parent="1" value="&lt;b&gt;Backorder Created&lt;/b&gt;&lt;br/&gt;Remaining items ship later" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1">
