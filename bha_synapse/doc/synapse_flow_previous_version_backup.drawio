          <mxGeometry as="geometry" x="320" y="1655" width="200" height="45" />
        </mxCell>
        <mxCell id="s9" parent="1" value="&lt;b&gt;Order Created in Synapse WMS&lt;/b&gt;&lt;br/&gt;Synapse returns &lt;code&gt;orderid&lt;/code&gt;&lt;br/&gt;Status: &lt;b&gt;Entered (1)&lt;/b&gt; &amp;rarr; &lt;b&gt;Committed (2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0e3e6;strokeColor=#0e8088;fontSize=12;" vertex="1">
          <mxGeometry as="geometry" x="660" y="695" width="360" height="55" />
