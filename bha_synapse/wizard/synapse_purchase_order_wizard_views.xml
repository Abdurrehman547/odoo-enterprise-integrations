<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_synapse_purchase_order_wizard_form" model="ir.ui.view">
        <field name="name">synapse.purchase.order.wizard.form</field>
        <field name="model">synapse.purchase.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to Synapse (Inbound Order)">
                <group>
                    <group>
                        <field name="purchase_order_id" invisible="1"/>
                        <field name="connection_id"/>
                        <field name="order_type"/>
                        <field name="priority"/>
                        <field name="po_number"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom" create="false">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="item_code"/>
                        <field name="quantity"/>
                        <field name="uom_code"/>
                    </list>
                </field>
                <footer>
                    <button name="action_send" string="Send to Synapse"
                            type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
