<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_synapse_order_wizard_form" model="ir.ui.view">
        <field name="name">synapse.order.wizard.form</field>
        <field name="model">synapse.order.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Order to Synapse">
                <group>
                    <group>
                        <field name="picking_id" invisible="not picking_id"/>
                        <field name="sale_order_id" invisible="not sale_order_id"/>
                        <field name="connection_id"/>
                        <field name="order_type"/>
                        <field name="priority"/>
                        <field name="shipping_carrier_id"/>
                    </group>
                    <group>
                        <field name="po_number"/>
                        <field name="shipping_term"/>
                        <field name="reference"/>
                    </group>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="item_code"/>
                        <field name="quantity"/>
                        <field name="uom_code"/>
                    </list>
                </field>
                <footer>
                    <button name="action_send" string="Send to Synapse" type="object"
                            class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

