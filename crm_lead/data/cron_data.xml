<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Drains the Microsoft Ads offline conversion queue (Odoo -> Bing). -->
        <record id="ir_cron_microsoft_ads_conversion_queue" model="ir.cron">
            <field name="name">Send Microsoft Ads Conversions</field>
            <field name="model_id" ref="crm_lead.model_microsoft_ads_conversion_queue"/>
            <field name="state">code</field>
            <field name="code">model.send_pending_conversions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
